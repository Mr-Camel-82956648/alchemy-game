# Preferred shared config for both the host backend and glyph router.
# Put these in backend/.env during local development.
FORGE_USE_REAL_LLM=true
LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_COMPAT_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LOG_LEVEL=INFO

# Legacy forge-only compatibility for projects still using Gemini in the
# semantic forge stage. Glyph router will not use GEMINI_API_KEY directly.
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# Legacy model alias for openai_compat:
# if OPENAI_COMPAT_MODEL is empty and LLM_PROVIDER=openai_compat,
# glyph router will fall back to LLM_MODEL.
# LLM_MODEL=gpt-5.4
